# Create a Telegram bot with @BotFather. Never commit real tokens.
TELEGRAM_BOT_TOKEN=
# Comma-separated private chat IDs. Empty disables Telegram in web service mode.
TELEGRAM_ALLOWED_CHAT_IDS=

# The process stays online 24/7. Check each 15 minutes; use 86400 for daily checks.
CHECK_INTERVAL_SECONDS=900
SOURCE_DELAY_SECONDS=3
REQUEST_TIMEOUT_SECONDS=25
DATABASE_PATH=data/assistant.sqlite3
MAX_DISCOVERY_PAGES=2
MAX_PRODUCTS=500

# Docker includes Chromium. For a local install, install the browser extra first.
BROWSER_ENABLED=true

# Optional lightweight LLM. No key is needed for demo, commands or structured extraction.
# Set a key to enable ambiguous-page classification and complex natural-language intents.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4.1-nano
LLM_DAILY_CALL_LIMIT=60

# Leave false on a normal GCP VM. Use true only with an explicitly trusted HTTP/SOCKS
# proxy that resolves DNS remotely while local DNS is unavailable. Host allowlists remain enforced.
PROXY_RESOLVES_DNS=false

# Optional administrator-owned JSON config; do not allow chat users to edit it.
SOURCES_FILE=

# Private web API. Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Never put this value in frontend source, build variables, or a public repository.
API_TOKEN=
# Exact HTTPS dashboard origins, comma separated; no trailing slash. Empty = same origin only.
CORS_ORIGINS=
# For compose.https.yaml: a hostname whose DNS A record points at the GCP VM.
API_DOMAIN=

# Optional official WhatsApp Cloud API. Enable the channel in dashboard settings after setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# International number, digits only; recipient must have opted in.
WHATSAPP_TO=
# Approved template with exactly ONE text parameter in its body.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Set a currently supported Graph API version from your Meta developer console, e.g. vNN.N.
WHATSAPP_GRAPH_VERSION=

# Combined setup: OpenClaw owns BOTH Telegram and QR-linked WhatsApp.
# Use compose.openclaw.yaml. Meta template/token settings above are unused in this mode.
NOTIFICATION_TRANSPORT=openclaw
OPENCLAW_URL=http://127.0.0.1:18789
# Generate a separate random gateway token; keep it off the frontend.
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_TELEGRAM_ACCOUNT=default
OPENCLAW_WHATSAPP_ACCOUNT=default
# true if linking your personal number and chatting with yourself; false for a dedicated bot number.
OPENCLAW_WHATSAPP_SELF_CHAT=false
OPENCLAW_BROWSER_PROFILE=openclaw
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.10.3-browser
